# Normalise line endings: LF in the repository and in every checkout.
* text=auto eol=lf

# Keep the published package to what a consumer actually runs. Everything below is
# development tooling: it belongs in the repository, not in every vendor/ directory.
/tests                          export-ignore
/.github                        export-ignore
/.editorconfig                  export-ignore
/.gitattributes                 export-ignore
/.gitignore                     export-ignore
/.phpcs.xml                     export-ignore
/phpunit.xml                    export-ignore
/phpstan.neon                   export-ignore
/phpstan-baseline.neon          export-ignore
/phpstan-tests.neon             export-ignore
/phpstan-tests-baseline.neon    export-ignore
/CONTRIBUTING.md                export-ignore

# LICENSE, readme.md, CHANGELOG.md, UPGRADE.md and SECURITY.md stay: they are small
# and are the files someone reads from inside vendor/.
