includes:
  - phpstan-baseline.neon

parameters:
  level: 7
  # The baseline is generated against one PHPStan version but CI also runs --prefer-lowest, where
  # a slightly older analyser reports fewer errors. An entry that then goes unmatched must not
  # fail the build; entries that do match are still enforced.
  reportUnmatchedIgnoredErrors: false
  paths:
    - src
  excludePaths:
    analyse:
      # bundled transliteration tables, used only when ext-intl is unavailable
      - 'src/Helpers/URLify.php'
  ignoreErrors:
    -
      # This package exists to ship traits: nothing inside src/ uses them,
      # consumers and the test suite do.
      identifier: trait.unused
